rules_version = '2';

// Mölkky Scores — Firestore security rules.
//
// Data model (see services/localStore.ts + services/cloudGames.ts):
//   games/{gameId}  — one document per game. Owned by `uid`. The client uses
//                     the local game id as the document id (setDoc, merge:true).
//   users/{userId}  — one document per signed-in user. Doc id IS the auth uid.
//
// Core invariants:
//   * A user may only read/write games they own (resource.data.uid == auth.uid).
//   * A user may only read/write their own user document (userId == auth.uid).
//   * Nobody may LIST the users collection (no email harvesting).
//   * Writes are shape/size validated so a compromised client can't store
//     arbitrary or unbounded data.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // ---- games ------------------------------------------------------------

    function gameFieldsValid(d) {
      // Top-level key allowlist (mirrors userFieldsValid below). This is every
      // field the client has EVER written to game docs: the Game type minus
      // the local-only fields stripped by services/cloudGames.ts
      // (syncStatus, localUpdatedAt). `id` is in the list because the payload
      // carries it (cloudUpsertGame doesn't strip it, and the pre-offline
      // client's updates spread the fetched doc — id included — back in), and
      // update rules validate the MERGED doc, so legacy docs need it allowed.
      return d.keys().hasOnly([
          'id', 'uid', 'players', 'rules', 'scores', 'gameStatus', 'gameRound',
          'turns', 'whichPlayersTurn', 'winningPlayerId', 'createdAt', 'updatedAt',
        ])
        && d.uid is string
        && d.players is list && d.players.size() > 0 && d.players.size() <= 64
        && d.scores is list && d.scores.size() <= 64
        // Mölkky games are short; cap turns well above any real game to bound
        // the document size (Firestore hard limit is 1 MiB / document).
        && d.turns is list && d.turns.size() <= 5000
        && d.gameStatus in ['inProgress', 'finished', 'abandoned']
        // int OR float: the JS SDK may serialize whole numbers either way.
        && (d.gameRound is int || d.gameRound is float)
        && d.whichPlayersTurn is string
        && d.rules is map
        && d.createdAt is string
        && d.updatedAt is string;
    }

    match /games/{gameId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;

      // On create the new doc must be owned by the caller.
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && gameFieldsValid(request.resource.data);

      // On update the caller must already own it AND may not transfer ownership.
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && gameFieldsValid(request.resource.data);

      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ---- users ------------------------------------------------------------

    function userFieldsValid(d) {
      // Top-level key allowlist so a compromised client can't stash arbitrary
      // extra fields on its user doc. NOTE: any legacy docs carrying fields
      // outside this list would need a one-time cleanup BEFORE these rules
      // deploy, or their next full-doc write will be rejected.
      //
      // removeAds / removeAdsInfo stay in the allowlist because UPDATE rules
      // validate the MERGED document — a paying user's doc contains them —
      // but they carry NO per-field shape checks here: they are written
      // exclusively by the `validatePurchase` Cloud Function via the Admin
      // SDK (which bypasses rules) with a server-side shape (transactionId,
      // originalTransactionId, environment, purchaseDate, validatedAt), and
      // the create/update guards below make them immutable to clients.
      return d.keys().hasOnly(['email', 'name', 'friends', 'createdAt', 'removeAds', 'removeAdsInfo'])
        && d.email is string
        && d.name is string
        && d.friends is list && d.friends.size() <= 1000
        && d.createdAt is string;
    }

    match /users/{userId} {
      // Read/write only your own user document. No list/query of the collection.
      allow get: if isSignedIn() && request.auth.uid == userId;
      // removeAds / removeAdsInfo are server-written only (Cloud Function
      // `validatePurchase`, Admin SDK): a create may not include them, and an
      // update may not touch them — so clients can neither grant themselves
      // the entitlement nor clobber a server-validated one.
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && userFieldsValid(request.resource.data)
        && !request.resource.data.keys().hasAny(['removeAds', 'removeAdsInfo']);
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && userFieldsValid(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['removeAds', 'removeAdsInfo']);
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // ---- everything else is denied ---------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
